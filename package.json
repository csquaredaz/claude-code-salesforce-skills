{
  "name": "claude-code-salesforce-skills",
  "private": true,
  "description": "Claude Code plugin (apex-standards) encoding Salesforce Apex engineering standards.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:md": "markdownlint-cli2",
    "lint": "npm run format:check && npm run lint:md && npm run check:templates",
    "prepare": "husky",
    "check:templates": "cmp .gitleaks.toml plugins/apex-standards/skills/sf-repo-scaffold/templates/sf-repo/.gitleaks.toml"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "markdownlint-cli2": "0.24.0",
    "prettier": "3.10.0"
  }
}
